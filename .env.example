# URL publique du site : alimente l'URL canonique, le sitemap, robots.txt
# et les cartes de partage.
#
# Facultative. Si elle est absente, vide ou invalide, le site retombe sur
# les variables de déploiement de Vercel, puis sur http://localhost:3000.
# Ne la définissez PAS avec une valeur vide sur votre hébergeur.
NEXT_PUBLIC_SITE_URL=https://nexa.vercel.app
